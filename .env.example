# ---------- API server ----------
PORT=3001
HOST=0.0.0.0
NODE_ENV=development

# Where SQLite, uploads and backups live (must be a persistent disk in production)
DATA_DIR=./data

# Cookies: set CROSS_SITE_COOKIES=1 when the SPA calls the API from another origin
# INSECURE_COOKIES=1   # only for production over plain HTTP
# CROSS_SITE_COOKIES=1
# COOKIE_SAMESITE=lax
# COOKIE_SECURE=1

# Comma-separated list of allowed browser origins (direct API mode only)
# CORS_ORIGINS=https://your-site.netlify.app

# ---------- SPA build (Netlify / Vite) ----------
# Leave empty when the SPA and API share an origin (or when Netlify proxies /api).
# Set to an absolute API origin to bypass the proxy (requires CORS + cross-site cookies).
# VITE_API_BASE=https://school-api.example.com

# API origin used by scripts/netlify-redirects.mjs to generate proxy rules
# API_ORIGIN=https://school-api.example.com
