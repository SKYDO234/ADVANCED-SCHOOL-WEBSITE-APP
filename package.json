{
  "name": "school-erp",
  "version": "1.0.0",
  "private": true,
  "description": "Advanced School Management ERP \u2014 website + application platform",
  "type": "module",
  "engines": {
    "node": ">=22.5"
  },
  "scripts": {
    "start": "node --disable-warning=ExperimentalWarning server/index.js",
    "dev": "node --disable-warning=ExperimentalWarning --watch server/index.js & npm --prefix client run dev",
    "build": "npm --prefix client run build",
    "serve": "npm run build && node --disable-warning=ExperimentalWarning server/index.js",
    "db:reset": "node --disable-warning=ExperimentalWarning server/db/reset.js",
    "seed:demo": "node --disable-warning=ExperimentalWarning server/db/seed-demo.js",
    "test:api": "node --disable-warning=ExperimentalWarning server/tests/api.test.js",
    "build:netlify": "npm --prefix client run build && node scripts/netlify-redirects.mjs"
  },
  "dependencies": {
    "compression": "^1.8.1",
    "cookie-parser": "^1.4.7",
    "exceljs": "^4.4.0",
    "express": "^4.21.2",
    "helmet": "^8.1.0",
    "multer": "^2.0.2",
    "nodemailer": "^10.3.1",
    "pdfkit": "^0.17.2",
    "zod": "^4.1.12"
  }
}
